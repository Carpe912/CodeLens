{
  "name": "codelens-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @codelens/web dev",
    "dev:web": "pnpm --filter @codelens/web dev",
    "dev:api": "pnpm --filter @codelens/api dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @codelens/api build",
    "build:web": "pnpm --filter @codelens/web build",
    "typecheck": "pnpm -r typecheck",
    "deploy": "bash scripts/deploy.sh"
  }
}