{
  "name": "codelens-vscode",
  "displayName": "Coopwire CodeLens",
  "description": "AI-powered code search and Q&A for your workspace",
  "version": "0.5.0",
  "publisher": "sunlingyue",
  "repository": {
    "type": "git",
    "url": "https://github.com/Carpe912/CodeLens.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeLens",
      "properties": {
        "codelens.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "打开工作区时自动索引"
        },
        "codelens.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "显示内联CodeLens（引用、调用）"
        },
        "codelens.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "显示悬停文档"
        },
        "codelens.allowedWorkspaces": {
          "type": "array",
          "default": [],
          "description": "总是允许索引的工作区URI列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": [
      {
        "command": "codelens.indexWorkspace",
        "title": "CodeLens: 索引工作区",
        "icon": "$(database)"
      },
      {
        "command": "codelens.reindexWorkspace",
        "title": "CodeLens: 重新索引工作区"
      },
      {
        "command": "codelens.incrementalIndex",
        "title": "CodeLens: 增量索引",
        "icon": "$(sync)"
      },
      {
        "command": "codelens.search",
        "title": "CodeLens: 搜索代码",
        "icon": "$(search)"
      },
      {
        "command": "codelens.askAI",
        "title": "CodeLens: 询问AI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codelens.askAboutSelection",
        "title": "CodeLens: 询问AI关于选中内容"
      },
      {
        "command": "codelens.showCallGraph",
        "title": "CodeLens: 显示调用图"
      },
      {
        "command": "codelens.openFile",
        "title": "CodeLens: 打开文件"
      },
      {
        "command": "codelens.refreshSearch",
        "title": "刷新",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codelens.askAboutSelection",
          "when": "editorHasSelection",
          "group": "codelens@1"
        }
      ],
      "view/title": [
        {
          "command": "codelens.search",
          "when": "view == codelensSearch",
          "group": "navigation"
        },
        {
          "command": "codelens.refreshSearch",
          "when": "view == codelensSearch",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codelens",
          "title": "CodeLens",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codelens": [
        {
          "id": "codelensSearch",
          "name": "搜索结果"
        },
        {
          "id": "codelensRepos",
          "name": "仓库"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "archiver": "^6.0.0",
    "form-data": "^4.0.0"
  }
}
