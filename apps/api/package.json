    "@babel/types": "^7.26.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.13",
    "@vue/compiler-sfc": "^3.5.13",
    "bullmq": "^5.30.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "openai": "^4.77.3",
    "pg": "^8.13.1",
    "segmentit": "^2.0.3",
    "ts-morph": "^24.0.0",
    "uuid": "^11.0.3",
    "zod": "^4.6.5"
