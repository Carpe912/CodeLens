{
  "name": "@codelens/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "rebuild-references": "tsx src/scripts/rebuild-references.ts",
    "rebuild-graph": "tsx src/scripts/rebuild-graph.ts",
    "check-dimensions": "tsx src/scripts/check-embedding-dimensions.ts",
    "check:sql": "tsx src/scripts/check-sql-schema.ts",
    "check:live-schema": "tsx src/scripts/check-live-schema.ts",
    "repair:constraints": "tsx src/scripts/repair-constraints.ts",
    "verify:routes": "tsx src/scripts/verify-routes.ts",
    "verify:graph": "tsx src/scripts/verify-graph.ts",
    "verify:memory": "tsx src/scripts/verify-memory.ts",
    "check:llm": "tsx src/scripts/check-llm.ts",
    "check:rerank": "tsx src/scripts/check-rerank.ts",
    "reembed": "tsx src/scripts/reembed.ts",
