# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codelens
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding API (XiaocaseAI)
EMBED_API_KEY=your_xiaocaseai_api_key_here
EMBED_BASE_URL=https://api.xiaocaseai.cn
EMBED_MODEL=text-embedding-v4
EMBED_DIMENSIONS=1024

# ========== Rerank API 配置（可选，选择其中一个即可） ==========

# 方案 1: XiaocaseAI Rerank（推荐，国内可用）
# 使用与 Embedding 相同的 API Key
# 支持模型:
#   - bge-reranker-v2-m3: BGE 重排序模型（推荐）
# 获取: https://api.xiaocaseai.cn
DASHSCOPE_API_KEY=your_xiaocaseai_api_key_here
DASHSCOPE_RERANK_MODEL=bge-reranker-v2-m3

# 方案 2: Jina AI Reranker（国内可用，支持中文）
# 模型: jina-reranker-v2-base-multilingual
# 免费额度: 每天 1000 次调用
# 获取: https://jina.ai/reranker
# JINA_API_KEY=your_jina_api_key_here

# 方案 3: BCE Reranker（开源，需自部署）
# 模型: maidalun1020/bce-reranker-base_v1
# 部署: https://github.com/netease-youdao/BCEmbedding
# BCE_RERANK_API_KEY=your_api_key_here
# BCE_RERANK_BASE_URL=http://localhost:8000

# 方案 4: Cohere Rerank（国外服务）
# 模型: rerank-english-v3.0
# 免费额度: 每月 1000 次调用
# 获取: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=your_cohere_api_key_here

# 服务端口
PORT=8787
