# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codelens
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== LLM 厂商配置 ==========
# LLM_PROVIDER: deepseek | anthropic（切换厂商只需改这一行）
# 未设置时会按可用凭据自动判断（有 DEEPSEEK_API_KEY 则用 deepseek）
LLM_PROVIDER=deepseek

# 可选：显式指定模型（留空则由代码按厂商取默认值）
#   deepseek-chat    稳定别名（当前实际生效 deepseek-flash，快、非推理）
#   deepseek-v4-pro  推理模型，更强但更慢；推理 token 会占用 max_tokens
LLM_MODEL=deepseek-chat

# DeepSeek（OpenAI 兼容协议；复用 openai 包，无需额外依赖）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic（保留作为回滚路径；LLM_PROVIDER=anthropic 时生效）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Embedding API（阿里百炼 DashScope）
# 注意：向量嵌入与 LLM 厂商无关——DeepSeek 不提供嵌入模型，这里保持不变。
# ⚠️ qwen3.7-text-embedding 原生维度是 1024，必须用 EMBED_DIMENSIONS=1536 指定，
#    才能与库里既有的 vector(1536) 列兼容；改错会让既有向量全部失效。
# ⚠️ 更换嵌入模型后，必须重刷全部向量：pnpm --filter @codelens/api reembed
EMBED_API_KEY=your_dashscope_api_key_here
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIMENSIONS=1536

# ========== Rerank 精排（已实现：apps/api/src/retrieval/rerank.ts） ==========
# 作用：检索链路第二阶段——先宽召回 RERANK_CANDIDATES 条候选，
#       再调 rerank 模型对 (query, document) 打语义相关性分并重排，最后截断。
# 关闭方式：RERANK_ENABLED 留空或不设为 'true'（默认关闭，行为与历史版本一致）。
# 容错：模型名不可用 / 超时 / 配额不足时**自动降级回规则排序**并进入 60s 冷却，
#       检索不会失败，日志会打印降级警告。
#
# 当前实现针对 DashScope 原生 text-rerank 接口：
#   POST {RERANK_BASE_URL}/api/v1/services/rerank/text-rerank/text-rerank
# 若换其他厂商，除 URL 外还需改 rerank.ts 里的请求/响应结构。
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=your_dashscope_api_key_here
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_CANDIDATES=50
RERANK_TIMEOUT_MS=3000

# 兼容旧变量名（RERANK_MODEL / RERANK_API_KEY 未设置时回退到这两个）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank

# 自检（需先配好上面的密钥）：
#   pnpm --filter @codelens/api check:rerank
# 会打印配置、真实 HTTP 状态与 top3 打分，用于确认模型名是否被服务端接受。

# 服务端口
PORT=8787
